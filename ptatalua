-- ==========================================================
-- 4) ARAYÜZ: ÇİFT KATMANLI PARENT (CoreGui -> PlayerGui)
-- ==========================================================
local GUI_NAME = "AccessControlPanel"

local function mountGui(gui)
    -- 1. katman: CoreGui (yetki yoksa pcall hata yakalar)
    local coreGui
    local okCore = pcall(function()
        coreGui = game:GetService("CoreGui")
        gui.Parent = coreGui
    end)
    if okCore and coreGui and gui.Parent == coreGui then
        return coreGui
    end

    -- 2. katman: PlayerGui
    gui.Parent = nil
    local playerGui = LocalPlayer:WaitForChild("PlayerGui")
    gui.Parent = playerGui
    return playerGui
end

local function removeOldPanels()
    pcall(function()
        local old = game:GetService("CoreGui"):FindFirstChild(GUI_NAME)
        if old then
            old:Destroy()
        end
    end)
    local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if playerGui then
        local old = playerGui:FindFirstChild(GUI_NAME)
        if old then
            old:Destroy()
        end
    end
end

