function StartMainScript()
    print("Giriş Başarılı, Sistem Çalışıyor")

    -- ==========================================================
    -- MENÜ KODU: yalnızca doğru şifreden sonra çalışır
    -- ==========================================================
    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local UIS = game:GetService("UserInputService")
    local TweenService = game:GetService("TweenService")
    local Workspace = game:GetService("Workspace")

    local LocalPlayer = Players.LocalPlayer
    local Camera = Workspace.CurrentCamera
    local Mouse = LocalPlayer:GetMouse()

    -- ==========================================
    -- DEĞİŞKENLER & DEĞERLER
    -- ==========================================
    local aimbotActive = false
    local aimbotSmoothActive = true
    local aimSmoothness = 0.5
    local teamCheckActive = false
    local wallCheckActive = true

    local spinbotActive = false
    local spinSpeed = 50
    local spinAngle = 0

    local speedActive = false
    local customSpeedValue = 32

    local flyActive = false
    local flySpeed = 60
    local invisibleActive = false
    local noclipActive = false
    local infJumpActive = false

    local clickTpActive = false
    local clickTpKey = Enum.KeyCode.T
    local bindingTeleportKey = false

    local aimbotKey = Enum.KeyCode.J
    local bindingAimbotKey = false

    -- FOV DEĞİŞKENLERİ
    local fovVisible = true
    local fovRadius = 150
    local mainThemeColor = Color3.fromRGB(148, 0, 211) 

    -- GİZLİ ESP DEĞİŞKENİ
    local hiddenEspActive = false

    local filterExclude = Enum.RaycastFilterType.Exclude or Enum.RaycastFilterType.Blacklist

    -- ==========================================
    -- GİZLİ İŞARETLEYİCİ (SADECE "!")
    -- ==========================================
    local function createHiddenESP(plr)
        local AlertText = Drawing.new("Text")
        AlertText.Visible = false
        AlertText.Text = "!"
        AlertText.Size = 28
        AlertText.Color = Color3.fromRGB(255, 40, 40)
        AlertText.Outline = true
        AlertText.OutlineColor = Color3.new(0, 0, 0)
        AlertText.Center = true
        AlertText.Font = 2 

        local function update()
            local connection
            connection = RunService.RenderStepped:Connect(function()
                if hiddenEspActive and plr.Character and plr.Character:FindFirstChild("Head") and plr.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid.Health > 0 and plr ~= LocalPlayer then
                    local head = plr.Character.Head
                    local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 2, 0))

                    if onScreen then
                        AlertText.Position = Vector2.new(screenPos.X, screenPos.Y)
                        AlertText.Visible = true
                    else
                        AlertText.Visible = false
                    end
                else
                    AlertText.Visible = false
                    if not plr.Parent then
                        connection:Disconnect()
                        AlertText:Remove()
                    end
                end
            end)
        end
        coroutine.wrap(update)()
    end

    for _, v in pairs(Players:GetPlayers()) do createHiddenESP(v) end
    Players.PlayerAdded:Connect(function(v) createHiddenESP(v) end)

    -- ==========================================
    -- XENO SOVEREIGN: NORMAL ESP
    -- ==========================================
    local XenoSettings = {
        BoxColor = Color3.fromRGB(148, 0, 211), 
        SkeletonColor = Color3.fromRGB(186, 85, 211), 
        TracerColor = Color3.fromRGB(148, 0, 211), 
        HealthBarGreen = Color3.fromRGB(0, 255, 100), 
        HealthBarRed = Color3.fromRGB(255, 40, 40), 
        Enabled = true,
        TracersEnabled = true
    }

    local function createXenoESP(plr)
        local Box = Drawing.new("Square")
        Box.Visible = false
        Box.Color = XenoSettings.BoxColor
        Box.Thickness = 1.5
        Box.Filled = false

        local HealthBarBg = Drawing.new("Line")
        HealthBarBg.Visible = false
        HealthBarBg.Color = XenoSettings.HealthBarRed
        HealthBarBg.Thickness = 3

        local HealthBar = Drawing.new("Line")
        HealthBar.Visible = false
        HealthBar.Color = XenoSettings.HealthBarGreen
        HealthBar.Thickness = 3

        local Tracer = Drawing.new("Line")
        Tracer.Visible = false
        Tracer.Color = XenoSettings.TracerColor
        Tracer.Thickness = 1.2
        Tracer.Transparency = 0.5

        local SkeletonLines = {}
        for i = 1, 14 do
            local line = Drawing.new("Line")
            line.Visible = false
            line.Color = XenoSettings.SkeletonColor
            line.Thickness = 1.2
            table.insert(SkeletonLines, line)
        end

        local R15_Links = {
            {"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"},
            {"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"}, {"LeftLowerArm", "LeftHand"},
            {"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"},
            {"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"}, {"LeftLowerLeg", "LeftFoot"},
            {"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}, {"RightLowerLeg", "RightFoot"}
        }

        local R6_Links = {
            {"Head", "Torso"}, {"Torso", "Left Arm"}, {"Torso", "Right Arm"},
            {"Torso", "Left Leg"}, {"Torso", "Right Leg"}
        }

        local function update()
            local connection
            connection = RunService.RenderStepped:Connect(function()
                if XenoSettings.Enabled and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid.Health > 0 and plr ~= LocalPlayer then
                    local char = plr.Character
                    local humRoot = char.HumanoidRootPart
                    local hum = char.Humanoid
                    local screenPos, onScreen = Camera:WorldToViewportPoint(humRoot.Position)

                    if onScreen then
                        local sizeX = 2500 / screenPos.Z
                        local sizeY = 4000 / screenPos.Z
                        local boxPos = Vector2.new(screenPos.X - sizeX / 2, screenPos.Y - sizeY / 2)

                        Box.Size = Vector2.new(sizeX, sizeY)
                        Box.Position = boxPos
                        Box.Visible = true

                        local healthRatio = hum.Health / hum.MaxHealth
                        local barHeight = sizeY * healthRatio
                        local barX = boxPos.X - 6

                        HealthBarBg.From = Vector2.new(barX, boxPos.Y)
                        HealthBarBg.To = Vector2.new(barX, boxPos.Y + sizeY)
                        HealthBarBg.Visible = true

                        HealthBar.From = Vector2.new(barX, boxPos.Y + sizeY)
                        HealthBar.To = Vector2.new(barX, boxPos.Y + sizeY - barHeight)
                        HealthBar.Visible = true

                        if XenoSettings.TracersEnabled then
                            Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                            Tracer.To = Vector2.new(screenPos.X, boxPos.Y + sizeY) 
                            Tracer.Visible = true
                        else
                            Tracer.Visible = false
                        end

                        local links = hum.RigType == Enum.HumanoidRigType.R15 and R15_Links or R6_Links

                        for i = 1, #SkeletonLines do
                            local line = SkeletonLines[i]
                            if links[i] then
                                local part1 = char:FindFirstChild(links[i][1])
                                local part2 = char:FindFirstChild(links[i][2])

                                if part1 and part2 then
                                    local p1, vis1 = Camera:WorldToViewportPoint(part1.Position)
                                    local p2, vis2 = Camera:WorldToViewportPoint(part2.Position)

                                    if vis1 or vis2 then
                                        line.From = Vector2.new(p1.X, p1.Y)
                                        line.To = Vector2.new(p2.X, p2.Y)
                                        line.Visible = true
                                    else
                                        line.Visible = false
                                    end
                                else
                                    line.Visible = false
                                end
                            else
                                line.Visible = false
                            end
                        end
                    else
                        Box.Visible = false
                        HealthBarBg.Visible = false
                        HealthBar.Visible = false
                        Tracer.Visible = false
                        for _, line in pairs(SkeletonLines) do line.Visible = false end
                    end
                else
                    Box.Visible = false
                    HealthBarBg.Visible = false
                    HealthBar.Visible = false
                    Tracer.Visible = false
                    for _, line in pairs(SkeletonLines) do line.Visible = false end

                    if not plr.Parent then
                        connection:Disconnect()
                        Box:Remove()
                        HealthBarBg:Remove()
                        HealthBar:Remove()
                        Tracer:Remove()
                        for _, line in pairs(SkeletonLines) do line:Remove() end
                    end
                end
            end)
        end
        coroutine.wrap(update)()
