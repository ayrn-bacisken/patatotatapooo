        local base = main.Position
        for _ = 1, 3 do
            for _, dx in ipairs({ 10, -10 }) do
                if not main.Parent then
                    return
                end
                main.Position = base + UDim2.fromOffset(dx, 0)
                task.wait(0.035)
            end
        end
        if main.Parent then
            main.Position = base
        end
    end

    -- Doğrulama mantığı
    local failedAttempts = 0
    local locked = false

    local function attempt()
        if locked then
            return
        end

        local entered = canonicalizeKey(input.Text)
        if entered == "" then
            status.TextColor3 = THEME.Error
            status.Text = "Lütfen lisans anahtarını girin."
            return
        end

        local ok, result = redeemKey(licenseState, entered)
        if ok then
            status.TextColor3 = THEME.Success
            status.Text = "Doğrulandı."
            gui:Destroy() -- paneli tamamen sil
            StartMainScript(licenseState.active)
            return
        end

        failedAttempts += 1
        input.Text = ""
        status.TextColor3 = THEME.Error
        if result == "used" then
            status.Text = ("Bu anahtarın süresi dolmuş (%d/%d)"):format(failedAttempts, MAX_ATTEMPTS)
        else
            status.Text = ("Geçersiz anahtar (%d/%d)"):format(failedAttempts, MAX_ATTEMPTS)
        end
        task.spawn(shake)

        if failedAttempts >= MAX_ATTEMPTS then
            locked = true
            task.spawn(function()
                for remaining = LOCK_SECONDS, 1, -1 do
                    if not gui.Parent then
                        return
                    end
                    status.Text = ("Çok fazla deneme. %d sn bekleyin."):format(remaining)
                    task.wait(1)
                end
                if not gui.Parent then
                    return
                end
                failedAttempts = 0
                locked = false
                status.TextColor3 = THEME.Muted
                status.Text = ""
            end)
        end
    end

    button.MouseButton1Click:Connect(attempt)
    input.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            attempt()
        end
    end)

    mountGui(gui)
    tween(scale, 0.25, { Scale = 1 })
end

