local function serializeState(state)
    local lines = { "v=1" }
    local a = state.active
    if a then
        lines[#lines + 1] = "tier=" .. a.tier
        lines[#lines + 1] = "key=" .. a.key
        lines[#lines + 1] = "activated=" .. a.activated
        lines[#lines + 1] = "expires=" .. (a.expires or 0)
    end
    lines[#lines + 1] = "seen=" .. state.seen
    local burned = {}
    for hash in pairs(state.burned) do
        burned[#burned + 1] = hash
    end
    table.sort(burned)
    for _, hash in ipairs(burned) do
        lines[#lines + 1] = "burned=" .. hash
    end
    local body = table.concat(lines, "\n")
    return body .. "\nsig=" .. sha256(SIGNATURE_SALT .. body)
end

local function parseState(text)
    local body, sig = string.match(text, "^(.*)\nsig=(%x+)%s*$")
    if not body or sha256(SIGNATURE_SALT .. body) ~= sig then
        return nil -- bozuk ya da elle değiştirilmiş kayıt
    end
    local state = { burned = {}, seen = 0 }
    local a = {}
    for line in string.gmatch(body, "[^\n]+") do
        local k, v = string.match(line, "^(%w+)=(.*)$")
        if k == "tier" then
            a.tier = v
        elseif k == "key" then
            a.key = v
        elseif k == "activated" then
            a.activated = tonumber(v)
        elseif k == "expires" then
            a.expires = tonumber(v)
        elseif k == "seen" then
            state.seen = tonumber(v) or 0
        elseif k == "burned" then
            state.burned[v] = true
        end
    end
    if a.tier and a.key and a.activated and a.expires ~= nil then
        if a.expires == 0 then
            a.expires = nil -- lifetime
        end
        state.active = a
    end
    return state
end

local function loadState()
    local candidates = {}
    if hasFileApi then
        local okExists, exists = pcall(isfile, LICENSE_FILE)
        if okExists and exists then
            local okRead, content = pcall(readfile, LICENSE_FILE)
            if okRead then
                candidates[#candidates + 1] = content
            end
        end
    end
    candidates[#candidates + 1] = _G[MEMORY_KEY] -- oturum içi yedek
    for _, text in ipairs(candidates) do
        if type(text) == "string" then
            local state = parseState(text)
            if state then
                return state
            end
        end
    end
    return { burned = {}, seen = 0 }
end

local function saveState(state)
    local text = serializeState(state)
    _G[MEMORY_KEY] = text
    if hasFileApi then
        pcall(writefile, LICENSE_FILE, text)
    end
end

-- Kayıtlı lisansı denetler. Dönüş: "none" | "ok" | "expired", mesaj
local function checkSavedLicense(state)
    local a = state.active
    if not a then
        return "none"
    end

    local tier = TIER_BY_ID[a.tier]
    local valid = tier ~= nil and HASH_TO_TIER[a.key] == tier
    if valid then
        if tier.seconds then
            valid = a.expires == a.activated + tier.seconds
        else
            valid = a.expires == nil
        end
    end
    if not valid then
        state.active = nil
        saveState(state)
        return "none"
    end

    local now = os.time()
    if tier.seconds then
        local reason
        if now + CLOCK_TOLERANCE < state.seen then
            reason = "Sistem saati geri alınmış. Yeni bir anahtar girin."
        elseif now >= a.expires then
            reason = "Lisansınızın süresi doldu. Yeni bir anahtar girin."
        end
        if reason then
            state.burned[a.key] = true -- süresi dolan anahtar bir daha kullanılamaz
            state.active = nil
            saveState(state)
            return "expired", reason
        end
    end

    state.seen = math.max(state.seen, now)
    saveState(state)
    return "ok"
end

-- Anahtarı etkinleştirir. Dönüş: true | false, "invalid" / "used"
local function redeemKey(state, canonicalKey)
    local keyHash = sha256(canonicalKey)
    local tier = HASH_TO_TIER[keyHash]
    if not tier then
        return false, "invalid"
    end
    if state.burned[keyHash] then
        return false, "used"
    end

    local now = os.time()
    state.active = {
        tier = tier.id,
        key = keyHash,
        activated = now,
        expires = tier.seconds and (now + tier.seconds) or nil,
    }
    state.seen = math.max(state.seen, now)
    saveState(state)
    return true, tier
end

local function describeLicense(a)
    local tier = TIER_BY_ID[a.tier]
    if not a.expires then
        return tier.label .. " (süresiz)"
    end
    local remain = math.max(0, a.expires - os.time())
    return string.format(
        "%s - %d gün %d saat kaldı",
        tier.label,
        math.floor(remain / 86400),
        math.floor((remain % 86400) / 3600)
    )
end

