        local hrp = character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        if state then
            local oldPos = hrp.CFrame
            hrp.CFrame = CFrame.new(oldPos.X, oldPos.Y + 50000, oldPos.Z)
            task.wait(0.1)
            hrp.Anchored = true
        else
            hrp.Anchored = false
            hrp.CFrame = CFrame.new(hrp.Position.X, hrp.Position.Y - 50000, hrp.Position.Z)
        end
    end

