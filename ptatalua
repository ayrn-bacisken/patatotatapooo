        createToggle(CombatPage, "Mevlana (Spinbot)", spinbotActive, function(v) spinbotActive = v end)
        createAdjuster(CombatPage, "Mevlana Hızı", spinSpeed, 10, 200, 10, function(v) spinSpeed = v end)

        -- VISUAL TAB
        createToggle(VisualPage, "XENO ESP Aktif", XenoSettings.Enabled, function(v) XenoSettings.Enabled = v end)
        createToggle(VisualPage, "XENO Tracers (Çizgiler)", XenoSettings.TracersEnabled, function(v) XenoSettings.TracersEnabled = v end)

        -- PLAYER TAB 
        createToggle(PlayerPage, "Hız Artışı (Speed)", speedActive, function(v) speedActive = v end)
        createAdjuster(PlayerPage, "Yürüme Hızı", customSpeedValue, 16, 250, 5, function(v) customSpeedValue = v end)

        -- MOVEMENT TAB 
        createToggle(MovementPage, "Işınlanma (Teleport)", clickTpActive, function(v) clickTpActive = v end)
        createKeybinder(MovementPage, "Teleport Tuşu", clickTpKey, function(k) clickTpKey = k end)
        createToggle(MovementPage, "Sınırsız Zıplama", infJumpActive, function(v) infJumpActive = v end)
        createToggle(MovementPage, "Noclip (Duvar Geç)", noclipActive, function(v) noclipActive = v end)
        createToggle(MovementPage, "Görünmezlik (FE Invisibility)", invisibleActive, function(v) 
            invisibleActive = v 
            toggleFEInvisibility(v)
        end)
        createToggle(MovementPage, "Uçma (Fly)", flyActive, function(v) flyActive = v end)
        createAdjuster(MovementPage, "Uçma Hızı", flySpeed, 10, 300, 10, function(v) flySpeed = v end)
    
        -- GİZLİ TAB 
        createToggle(SecretPage, "Gizli İşaretleyici (!)", hiddenEspActive, function(v) hiddenEspActive = v end)

        UIS.InputBegan:Connect(function(input, processed)
            if processed then return end
            if input.KeyCode == Enum.KeyCode.H then
                if Main.Visible then
                    TweenService:Create(Main, TweenInfo.new(0.15, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Size = UDim2.new(0, 620, 0, 0)}):Play()
                    task.delay(0.15, function() Main.Visible = false end)
                else
                    Main.Size = UDim2.new(0, 620, 0, 0)
                    Main.Visible = true
                    TweenService:Create(Main, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, 620, 0, 410)}):Play()
                end
            end
        end)
    end

    task.spawn(initUI)
end

openAccessPanel()
