    RunService.RenderStepped:Connect(function()
        FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        FOVCircle.Radius = fovRadius
        FOVCircle.Color = mainThemeColor
    
        FOVCircle.Visible = fovVisible and aimbotActive

        -- GÜVENLİ VE DÜZELTİLMİŞ SPINBOT MANTIĞI
        if LocalPlayer.Character then
            local char = LocalPlayer.Character
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local rootJoint = hrp:FindFirstChild("RootJoint") or (char:FindFirstChild("LowerTorso") and char.LowerTorso:FindFirstChild("Root"))
                if rootJoint then
                    -- Orijinal duruşu hafızaya al
                    if not rootJoint:FindFirstChild("OriginalC0") then
                        local val = Instance.new("CFrameValue")
                        val.Name = "OriginalC0"
                        val.Value = rootJoint.C0
                        val.Parent = rootJoint
                    end

                    if spinbotActive then
                        spinAngle = (spinAngle + (spinSpeed * 1.5)) % 360
                        rootJoint.C0 = rootJoint.OriginalC0.Value * CFrame.Angles(0, math.rad(spinAngle), 0)
                    elseif rootJoint:FindFirstChild("OriginalC0") then
                        rootJoint.C0 = rootJoint.OriginalC0.Value
                    end
                end
            end
        end

        if aimbotActive then
            local hedef = getEnYakinFOVOyuncu()
            if hedef and hedef.Character then
                local targetPart = getHeadPart(hedef.Character)
                if targetPart then
                    if aimbotSmoothActive then
                        Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, targetPart.Position), aimSmoothness)
                    else
                        Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPart.Position)
                    end
                end
            end
        end
    
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
            local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if speedActive then
                hum.WalkSpeed = customSpeedValue
            else
                hum.WalkSpeed = 16
            end
        end

        if flyActive and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = LocalPlayer.Character.HumanoidRootPart
            local moveDir = Vector3.new()
        
            if UIS:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Camera.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - Camera.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - Camera.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Camera.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.E) then moveDir = moveDir + Vector3.new(0, 1, 0) end
            if UIS:IsKeyDown(Enum.KeyCode.Q) then moveDir = moveDir - Vector3.new(0, 1, 0) end
        
            if moveDir.Magnitude > 0 then moveDir = moveDir.Unit end
            hrp.Velocity = moveDir * flySpeed
        end
    end)

