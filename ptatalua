-- ==========================================================
local THEME = {
    Backdrop = Color3.fromRGB(0, 0, 0),
    Panel = Color3.fromRGB(20, 20, 27),
    PanelStroke = Color3.fromRGB(48, 48, 66),
    Field = Color3.fromRGB(30, 30, 41),
    Accent = Color3.fromRGB(99, 102, 241),
    AccentHover = Color3.fromRGB(121, 124, 255),
    Text = Color3.fromRGB(236, 236, 246),
    Muted = Color3.fromRGB(140, 140, 165),
    Error = Color3.fromRGB(248, 90, 90),
    Success = Color3.fromRGB(70, 210, 120),
}

local function addCorner(parent, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius)
    corner.Parent = parent
    return corner
end

local function addStroke(parent, color, thickness)
    local stroke = Instance.new("UIStroke")
    stroke.Color = color
    stroke.Thickness = thickness
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = parent
    return stroke
end

local function makeLabel(parent, text, font, size, color, height, order)
    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(1, 0, 0, height)
    label.Font = font
    label.Text = text
    label.TextSize = size
    label.TextColor3 = color
    label.TextXAlignment = Enum.TextXAlignment.Center
    label.LayoutOrder = order
    label.Parent = parent
    return label
end

local function openAccessPanel()
    removeOldPanels()

    local expectedIndex = Random.new():NextInteger(1, #PASSWORD_HASHES)

    local gui = Instance.new("ScreenGui")
    gui.Name = GUI_NAME
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 1000
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

    local backdrop = Instance.new("Frame")
    backdrop.Name = "Backdrop"
    backdrop.Size = UDim2.fromScale(1, 1)
    backdrop.BackgroundColor3 = THEME.Backdrop
    backdrop.BackgroundTransparency = 0.45
    backdrop.BorderSizePixel = 0
    backdrop.Parent = gui

    local main = Instance.new("Frame")
    main.Name = "Main"
    main.AnchorPoint = Vector2.new(0.5, 0.5)
    main.Position = UDim2.fromScale(0.5, 0.5)
    main.Size = UDim2.fromOffset(380, 300)
    main.BackgroundColor3 = THEME.Panel
    main.BorderSizePixel = 0
    main.Parent = backdrop
    addCorner(main, 16)
    addStroke(main, THEME.PanelStroke, 1.5)

    local scale = Instance.new("UIScale")
    scale.Scale = 0.9
    scale.Parent = main

    local content = Instance.new("Frame")
    content.Name = "Content"
    content.Size = UDim2.fromScale(1, 1)
    content.BackgroundTransparency = 1
    content.Parent = main

    local padding = Instance.new("UIPadding")
    padding.PaddingTop = UDim.new(0, 24)
    padding.PaddingBottom = UDim.new(0, 24)
    padding.PaddingLeft = UDim.new(0, 26)
    padding.PaddingRight = UDim.new(0, 26)
    padding.Parent = content

    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    layout.Padding = UDim.new(0, 12)
    layout.Parent = content

    makeLabel(content, "Yazılım Erişim Paneli", Enum.Font.GothamBold, 21, THEME.Text, 28, 1)
    makeLabel(content, "Devam etmek için kimlik doğrulaması gerekli", Enum.Font.Gotham, 13, THEME.Muted, 18, 2)

    -- İstenen şifre indeksi
    local pill = Instance.new("Frame")
    pill.Name = "IndexPill"
    pill.Size = UDim2.fromOffset(190, 28)
    pill.BackgroundColor3 = THEME.Accent
    pill.BackgroundTransparency = 0.82
    pill.BorderSizePixel = 0
    pill.LayoutOrder = 3
    pill.Parent = content
    addCorner(pill, 14)
    addStroke(pill, THEME.Accent, 1)

    local pillText = Instance.new("TextLabel")
    pillText.BackgroundTransparency = 1
    pillText.Size = UDim2.fromScale(1, 1)
    pillText.Font = Enum.Font.GothamBold
    pillText.Text = ("Lütfen %d. şifreyi girin"):format(expectedIndex)
    pillText.TextSize = 13
    pillText.TextColor3 = THEME.Text
    pillText.Parent = pill

    -- Şifre kutusu
    local input = Instance.new("TextBox")
    input.Name = "PasswordInput"
    input.Size = UDim2.new(1, 0, 0, 44)
    input.BackgroundColor3 = THEME.Field
    input.BorderSizePixel = 0
    input.Font = Enum.Font.Gotham
    input.TextSize = 15
    input.TextColor3 = THEME.Text
    input.PlaceholderText = "Şifreyi buraya yazın"
    input.PlaceholderColor3 = THEME.Muted
    input.Text = ""
    input.ClearTextOnFocus = false
    input.TextXAlignment = Enum.TextXAlignment.Left
    input.LayoutOrder = 4
    input.Parent = content
    addCorner(input, 10)
    local inputStroke = addStroke(input, THEME.PanelStroke, 1.2)

    local inputPad = Instance.new("UIPadding")
    inputPad.PaddingLeft = UDim.new(0, 14)
    inputPad.PaddingRight = UDim.new(0, 14)
    inputPad.Parent = input

    -- Giriş butonu
    local button = Instance.new("TextButton")
    button.Name = "LoginButton"
    button.Size = UDim2.new(1, 0, 0, 44)
    button.BackgroundColor3 = THEME.Accent
    button.BorderSizePixel = 0
    button.AutoButtonColor = false
    button.Font = Enum.Font.GothamBold
    button.TextSize = 15
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.Text = "Giriş"
    button.LayoutOrder = 5
    button.Parent = content
    addCorner(button, 10)

    local status = makeLabel(content, "", Enum.Font.GothamMedium, 13, THEME.Muted, 18, 6)

    -- Etkileşim animasyonları
    local function tween(obj, time, props)
        TweenService:Create(obj, TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
    end

    button.MouseEnter:Connect(function()
        tween(button, 0.15, { BackgroundColor3 = THEME.AccentHover })
    end)
    button.MouseLeave:Connect(function()
        tween(button, 0.15, { BackgroundColor3 = THEME.Accent })
    end)
    input.Focused:Connect(function()
        tween(inputStroke, 0.15, { Color = THEME.Accent })
    end)
    input.FocusLost:Connect(function()
        tween(inputStroke, 0.15, { Color = THEME.PanelStroke })
    end)

    local function shake()
        local base = main.Position
        for _ = 1, 3 do
            for _, dx in ipairs({ 10, -10 }) do
                if not main.Parent then
                    return
                end
                main.Position = base + UDim2.fromOffset(dx, 0)
                task.wait(0.035)
            end
        end
        if main.Parent then
            main.Position = base
        end
    end

    -- Doğrulama mantığı
    local failedAttempts = 0
    local locked = false

    local function attempt()
        if locked then
            return
        end

        local entered = string.match(input.Text, "^%s*(.-)%s*$") or ""
        if entered == "" then
            status.TextColor3 = THEME.Error
            status.Text = "Lütfen şifreyi girin."
            return
        end

        if sha256(entered) == PASSWORD_HASHES[expectedIndex] then
            status.TextColor3 = THEME.Success
            status.Text = "Doğrulandı."
            gui:Destroy() -- paneli tamamen sil
            StartMainScript()
            return
        end

        failedAttempts += 1
        input.Text = ""
        status.TextColor3 = THEME.Error
        status.Text = ("Hatalı şifre (%d/%d)"):format(failedAttempts, MAX_ATTEMPTS)
        task.spawn(shake)

        if failedAttempts >= MAX_ATTEMPTS then
            locked = true
            task.spawn(function()
                for remaining = LOCK_SECONDS, 1, -1 do
                    if not gui.Parent then
                        return
                    end
                    status.Text = ("Çok fazla deneme. %d sn bekleyin."):format(remaining)
                    task.wait(1)
                end
                if not gui.Parent then
                    return
                end
                failedAttempts = 0
                locked = false
                status.TextColor3 = THEME.Muted
                status.Text = ""
            end)
        end
    end

    button.MouseButton1Click:Connect(attempt)
    input.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            attempt()
        end
    end)

    mountGui(gui)
    tween(scale, 0.25, { Scale = 1 })
end

